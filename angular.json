{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": { "analytics": false },
  "projects": {
    "chairo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "chairo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/chairo",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "*.png", "input": "assets/plates", "output": "assets/plates" },
              { "glob": "*.mp3", "input": "assets/sounds", "output": "assets/sounds" },
              { "glob": "**/*", "input": "public" }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                { "type": "initial", "maximumWarning": "250kB", "maximumError": "300kB" },
                { "type": "anyComponentStyle", "maximumWarning": "15kB", "maximumError": "20kB" }
              ]
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "chairo:build:production" },
            "development": { "buildTarget": "chairo:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
